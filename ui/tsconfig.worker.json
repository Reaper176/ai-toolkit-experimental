{
    // tsconfig.worker.json
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2020",
        "lib": ["es2022", "dom"],
        "outDir": "dist",
        "rootDir": ".",
        "moduleResolution": "node",
        "types": [
            "node",
            "react"
        ],
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "paths": {
            "@/*": [
                "./cron/*"
            ]
        }
    },
    "include": [
        "cron/**/*.ts"
    ]
}
