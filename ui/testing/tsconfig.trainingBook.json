{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "baseUrl": "..",
    "incremental": false,
    "isolatedModules": false,
    "jsx": "react-jsx",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "paths": { "@/*": ["src/*"] },
    "rootDir": "..",
    "target": "es2022"
  },
  "include": ["trainingBookFacts.ts", "trainingBook*.test.ts", "trainingBook*.test.tsx"],
  "exclude": ["../.next", "../node_modules"]
}
