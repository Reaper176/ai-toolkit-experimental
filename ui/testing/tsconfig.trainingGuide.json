{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "baseUrl": "..",
    "incremental": false,
    "isolatedModules": false,
    "jsx": "react-jsx",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "paths": { "@/*": ["src/*"] },
    "rootDir": "..",
    "target": "es2022"
  },
  "include": [
    "trainingGuideLink.test.tsx",
    "trainingGuideMarkdownPaths.test.ts",
    "trainingGuideNavigation.test.tsx",
    "trainingGuideReader.test.ts",
    "../src/components/TrainingGuideLink.tsx",
    "../src/components/TrainingGuideMarkdown.tsx",
    "../src/components/TrainingGuideNavigation.tsx",
    "../src/helpers/trainingGuideMarkdown.ts",
    "../src/server/trainingGuideReader.ts"
  ],
  "exclude": ["../.next", "../node_modules"]
}
