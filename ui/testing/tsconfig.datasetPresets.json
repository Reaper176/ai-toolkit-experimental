{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "baseUrl": "..",
    "incremental": false,
    "isolatedModules": false,
    "jsx": "react-jsx",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "paths": { "@/*": ["src/*"] },
    "rootDir": "..",
    "target": "es2020"
  },
  "include": [
    "../src/server/datasetMaskService.ts",
    "../src/server/datasetMaskRouteHandlers.ts",
    "../src/helpers/datasetPresets.ts",
    "../src/helpers/datasetSelection.ts",
    "../src/components/DatasetImageCard.tsx",
    "../src/server/datasetPresetSnapshotService.ts",
    "../src/server/datasetPresetService.ts",
    "../src/server/datasetPresetRouteHandlers.ts",
    "../src/server/datasetPresetMaintenance.ts",
    "../cron/worker.ts",
    "../src/server/jobDatasetPresetService.ts",
    "../src/server/jobStartOrchestration.ts",
    "../src/server/jobDatasetPresetPrismaStore.ts",
    "../src/components/DatasetSelectionToolbar.tsx",
    "../src/components/DatasetPresetDialog.tsx",
    "../src/components/DatasetSourceControl.tsx",
    "../src/components/DatasetProvenance.tsx",
    "../src/components/DatasetPresetLifecycleControls.tsx",
    "../src/hooks/useJob.tsx",
    "datasetPreset*.test.ts",
    "datasetMaskService.test.ts",
    "datasetMaskRouteHandlers.test.ts",
    "datasetPreset*.test.tsx",
    "datasetProvenance.test.tsx",
    "datasetSourceControl.test.tsx",
    "jobDataset*.test.ts",
    "jobsRoute.test.ts"
  ],
  "exclude": ["../.next", "../node_modules"]
}
